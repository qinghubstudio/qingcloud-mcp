# ================================
# Qingcloud MCP Service Environment Variables
# ================================
# Copy this file to .env and customize the values

# ================================
# Java Configuration
# ================================
JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8

# ================================
# Server Configuration
# ================================
SERVER_PORT=8080

# ================================
# MCP Configuration
# ================================
# Transport mode: stdio, http
MCP_TRANSPORT_MODE=http

# HTTP endpoint path
MCP_HTTP_ENDPOINT=/mcp

# ================================
# Xiaohongshu Configuration
# ================================
# Signature strategy: local, playwright, extension
XHS_SIGNATURE_STRATEGY=playwright

# ================================
# Logging Configuration
# ================================
LOGGING_LEVEL_COM_QINGCLOUD_MCP=DEBUG
LOGGING_LEVEL_IO_MODELCONTEXTPROTOCOL=DEBUG

# ================================
# Docker Configuration
# ================================
# Container name
CONTAINER_NAME=qingcloud-mcp

# Image name and tag
IMAGE_NAME=qingcloud-mcp
IMAGE_TAG=latest

# ================================
# Resource Limits
# ================================
CPU_LIMIT=2.0
MEMORY_LIMIT=1G
CPU_RESERVATION=0.5
MEMORY_RESERVATION=256M
